# Copy this file to webull_credentials.env (same directory) and fill in the real values.
# webull_credentials.env is gitignored — never commit real credentials.
#
# WEBULL_APP_KEY / WEBULL_APP_SECRET: from Webull OpenAPI Management (developer.webull.com).
# WEBULL_ACCOUNT_ID: left blank on first run — the script will look it up via
#   get_account_list() and print it so you can paste it back in here for subsequent runs
#   (pinning it avoids silently trading on the wrong account if you ever have more than one).
#
# WEBULL_APP_KEY=paste-your-app-key-here
# WEBULL_APP_SECRET=paste-your-app-secret-here
# WEBULL_ACCOUNT_ID=
