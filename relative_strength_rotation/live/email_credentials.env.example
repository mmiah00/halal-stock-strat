# Copy this file to email_credentials.env (same directory) and fill in the real values.
# email_credentials.env is gitignored — never commit real credentials.
#
# EMAIL_SMTP_USER: the Gmail address that both SENDS and RECEIVES the email (this script
#   always sends to itself) — required, no hardcoded fallback.
# EMAIL_SMTP_APP_PASSWORD: a Gmail App Password, NOT your regular Google password.
#   Requires 2-Step Verification to be enabled on the account first.
#   Generate one at: https://myaccount.google.com/apppasswords
#   (choose "Mail" as the app; Google will show you a 16-character password once)
#
# EMAIL_SMTP_USER=your-email@gmail.com
# EMAIL_SMTP_APP_PASSWORD=paste-the-16-character-app-password-here
